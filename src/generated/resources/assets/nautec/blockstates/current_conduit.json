{
  "multipart": [
    {
      "apply": {
        "model": "nautec:block/current_conduit_core"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_arm"
      },
      "when": {
        "down": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_cap"
      },
      "when": {
        "down": "none|blocked"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_arm",
        "x": 180
      },
      "when": {
        "up": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_cap",
        "x": 180
      },
      "when": {
        "up": "none|blocked"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_collar",
        "x": 180
      },
      "when": {
        "up": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_arm",
        "x": 90,
        "y": 180
      },
      "when": {
        "north": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_cap",
        "x": 90,
        "y": 180
      },
      "when": {
        "north": "none|blocked"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_arm",
        "x": 90
      },
      "when": {
        "south": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_cap",
        "x": 90
      },
      "when": {
        "south": "none|blocked"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_collar",
        "x": 90
      },
      "when": {
        "south": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_arm",
        "x": 90,
        "y": 90
      },
      "when": {
        "west": "connected"
      }
    },
    {
      "apply": {
        "model": "nautec:block/current_conduit_cap",
        "x": 90,
        "y": 90
      },
      "when": {
        "west": "none|blocked"
      }
