# Markdown: ignored by default. Tracked: root README, LICENSE and CHANGELOG,
# release changelogs, docs and wiki pages, and markdown inside mod sources
*.md
!/README.md
!/LICENSE.md
!/CHANGELOG.md
!/metadata/changelogs/**/*.md
!/docs/**/*.md
!/wiki/**/*.md
!**/src/**/*.md

